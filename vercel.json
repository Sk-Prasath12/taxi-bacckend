{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install --include=dev --prefix taxi-backend-main",
  "buildCommand": "npm run build --prefix taxi-backend-main",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "taxi-backend-main/src/config/firebase-service.json"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
