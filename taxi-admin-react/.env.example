# ─── Local dev (copy to .env) ───
# Use live Vercel backend (same as APK):
VITE_API_BASE_URL=https://taxi-bacckend.vercel.app/api/v1

# Or local Docker backend:
# VITE_API_BASE_URL=http://localhost:3000/api/v1

# ─── Vercel admin deploy ───
# Project → Settings → Environment Variables → Production + Preview:
#   VITE_API_BASE_URL = https://taxi-bacckend.vercel.app/api/v1
# Then redeploy (env vars are baked in at build time).

# ─── Backend (taxi-bacckend on Vercel) ───
# Optional CORS if browser blocks admin:
#   CORS_ORIGINS=https://YOUR-ADMIN.vercel.app,http://localhost:5173
