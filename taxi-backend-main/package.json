{
  "name": "taxi-backend-main",
  "version": "1.0.0",
  "description": "Production-ready modular backend foundation for Taxi App",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "ts-node src/server.ts",
    "start:prod": "node dist/src/server.js",
    "seed": "ts-node seed/run-seeds.ts",
    "seed:admin": "ts-node seed/run-seeds.ts --only=seed-admin",
    "migrate": "ts-node migrations/run-migrations.ts",
    "migrate:down": "ts-node migrations/run-migrations.ts --down",
    "migrate:users": "npm run migrate",
    "lint": "tsc --noEmit",
    "test": "mocha \"test/**/*.js\"",
    "test:coverage": "cross-env NODE_ENV=test nyc mocha \"test/**/*.js\"",
    "coverage:report": "nyc report --reporter=html",
    "coverage:open": "start coverage/index.html"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "test/**",
      "node_modules/**",
      "**/*.d.ts"
    ],
    "reporter": [
      "text",
      "html"
    ],
    "all": true,
    "require": [
      "ts-node/register/transpile-only"
    ]
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "mongoose",
    "docker"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@aws-sdk/s3-request-presigner": "^3.1023.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.8.0",
    "geolib": "^3.3.14",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.2",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.11",
    "axios": "^1.15.2",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "mocha": "^11.7.5",
    "nyc": "^18.0.0",
    "sinon": "^21.1.2",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
