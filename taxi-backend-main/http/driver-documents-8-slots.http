###############################################################################
# Driver KYC (8 Upload Calls) - REST Client
# Uses same local PDF for quick testing:
#   C:/Users/ashwi/Downloads/truck.pdf
###############################################################################

@baseUrl = http://localhost:3000
@driverEmail = driver04@yopmail.com
@driverPassword = driver112233
@uploadFile = C:/Users/ashwi/Downloads/truck.pdf

### Login (run first)
# @name driverKyc8Login
POST {{baseUrl}}/api/drivers/login
Content-Type: application/json

{
  "email": "{{driverEmail}}",
  "password": "{{driverPassword}}"
}

###
# Token note:
# Use {{driverKyc8Login.response.body.$.token}} directly in Authorization headers.

### 1) Aadhaar Front - IDENTITY
POST {{baseUrl}}/api/drivers/documents/upload?document_type=IDENTITY
Authorization: Bearer {{driverKyc8Login.response.body.$.token}}
Content-Type: multipart/form-data; boundary=----Upload01

------Upload01
Content-Disposition: form-data; name="file"; filename="aadhaar-front.pdf"
Content-Type: application/pdf

< {{uploadFile}}
------Upload01--

### 2) Aadhaar Back - IDENTITY
POST {{baseUrl}}/api/drivers/documents/upload?document_type=IDENTITY
Authorization: Bearer {{driverKyc8Login.response.body.$.token}}
Content-Type: multipart/form-data; boundary=----Upload02

------Upload02
Content-Disposition: form-data; name="aadhar"; filename="aadhaar-back.pdf"
Content-Type: application/pdf

< {{uploadFile}}
------Upload02--

### 3) PAN Front - IDENTITY
POST {{baseUrl}}/api/drivers/documents/upload?document_type=IDENTITY
Authorization: Bearer {{driverKyc8Login.response.body.$.token}}
Content-Type: multipart/form-data; boundary=----Upload03

------Upload03
Content-Disposition: form-data; name="document"; filename="pan-front.pdf"
Content-Type: application/pdf

< {{uploadFile}}
------Upload03--

### 4) PAN Back - IDENTITY
POST {{baseUrl}}/api/drivers/documents/upload?document_type=IDENTITY
Authorization: Bearer {{driverKyc8Login.response.body.$.token}}
Content-Type: multipart/form-data; boundary=----Upload04

------Upload04
Content-Disposition: form-data; name="file"; filename="pan-back.pdf"
Content-Type: application/pdf

< {{uploadFile}}
------Upload04--

