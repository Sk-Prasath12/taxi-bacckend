# Copy to .env.local for development (never commit secrets)

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Comma-separated admin/web origins (production required)
# CORS_ORIGINS=https://admin.example.com

# PUBLIC_API_URL=https://api.example.com

MONGO_URI=mongodb://taxiadmin:CHANGE_ME@127.0.0.1:27018/taxi_app?authSource=admin

JWT_ACCESS_SECRET=change-me-min-16-chars
JWT_REFRESH_SECRET=change-me-min-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_TLS_REJECT_UNAUTHORIZED=true

OSRM_URL=http://127.0.0.1:5000

# Nearby online drivers matching radius (km). Backend is the authority.
NEARBY_DRIVER_RADIUS_KM=10
# Auto-cancel SEARCHING_DRIVER if no accept within this many seconds.
RIDE_SEARCH_TIMEOUT_SEC=120

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS_S3_BUCKET_DOCUMENTS=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
